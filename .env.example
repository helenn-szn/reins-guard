# Wallet that deploys the contracts and pays gas for demo wallets.
# It must deploy BOTH the vault and the reactive contract: its address is the ReactVM id
# the vault trusts for callbacks.
DEPLOYER_PRIVATE_KEY=0x...
# Protects /api/admin (deployment steps)
ADMIN_KEY=choose-a-long-random-string
# Optional: your own Base Sepolia RPC
BASE_SEPOLIA_RPC=https://sepolia.base.org
# Optional overrides for deployments.json
USD_ADDRESS=
VAULT_ADDRESS=
REACTIVE_ADDRESS=
